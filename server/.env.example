# Never commit real .env credentials. Configure Production values in Vercel.
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CONTACT_TO=
CONTACT_SENDER_NAME="Mae Ann Laurel - Portfolio"

# Account 1 is tried first. SMTP_USER/SMTP_PASS must have matching counts.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls

# Optional JSON array for credentials containing commas or different hosts.
SMTP_ACCOUNTS_JSON=
SMTP_TIMEOUT_SECONDS=5
SMTP_TOTAL_BUDGET_SECONDS=24

# In-memory, instance-local limits only; Turnstile is mandatory in production.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=900
CONTACT_GLOBAL_DAILY_LIMIT=60
TRUST_PROXY_HEADERS=false
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=mal.jpano.dev
TURNSTILE_REQUIRED=false
